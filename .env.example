# Copy to .env. Every module defaults to stub; flip one at a time.
DB_MODE=stub              # stub | sqlite | tiger
INDICATORS_MODE=stub      # stub | real
TOOLS_MODE=stub           # stub | real
PROPOSALS_MODE=stub       # stub | real
AUDITOR_MODE=stub         # stub | real
PERSONAL_MODE=stub        # stub | real
HOUSE_MODE=stub           # stub | real
TREASURER_MODE=stub       # stub | real
LLM_MODE=stub             # stub | grok
NESSIE_MODE=stub          # stub | live
OUTBOX_MODE=stub          # stub | http (http posts to GATEWAY_URL/send)
GATEWAY_MODE=sim          # sim | photon
GATEWAY_FANOUT=           # 1 = relay group replies to all 3 DMs (Photon shared pool has no groups)

BRAIN_URL=http://localhost:8000
GATEWAY_URL=http://localhost:8787
# Extra browser origins for the brain (dashboard/Expo dev origins are always allowed)
CORS_ORIGINS=
EXPO_TUNNEL_URL=          # e.g. https://abc-anonymous-8081.exp.direct
SQLITE_PATH=              # empty = brain/house.db (absolute; works from any cwd)

XAI_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning  # xAI chat model; reasoning models (grok-4.7) exceed the 8s timeout
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
DATABASE_URL=

# Telegram house group (see EXTENDED_FEAT.md); empty token = iMessage only
TELEGRAM_BOT_TOKEN=
ALEX_TELEGRAM=            # numeric Telegram user id or @username
SAM_TELEGRAM=
JORDAN_TELEGRAM=

# Roommate handles (phone or email); sim defaults are sim:<id>
ALEX_HANDLE=
SAM_HANDLE=
JORDAN_HANDLE=
